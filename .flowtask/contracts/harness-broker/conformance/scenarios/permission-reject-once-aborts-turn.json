{
  "name": "permission-reject-once-aborts-turn",
  "description": "A child that ends the whole turn with cancelled when the client rejects once, as the OpenCode harness does.",
  "session_id": "session-1",
  "behavior": {
    "on_cancel": "ignore",
    "on_stdin_end": "ignore",
    "start_after_stdin_end": false,
    "record_messages_to": null
  },
  "new_session_error": null,
  "steps": [
    {
      "request_permission": {
        "tool": {
          "kind": "execute",
          "title": "Run command"
        },
        "options": [
          {
            "option_id": "allow_once",
            "kind": "allow_once",
            "name": "Allow once"
          },
          {
            "option_id": "allow_always",
            "kind": "allow_always",
            "name": "Allow always"
          },
          {
            "option_id": "reject_once",
            "kind": "reject_once",
            "name": "Reject once"
          },
          {
            "option_id": "reject_always",
            "kind": "reject_always",
            "name": "Reject always"
          }
        ],
        "on_allow_once": [
          {
            "end_turn": {
              "stop_reason": "end_turn",
              "usage": null
            }
          }
        ],
        "on_reject_once": [
          {
            "end_turn": {
              "stop_reason": "cancelled",
              "usage": null
            }
          }
        ]
      }
    }
  ]
}
