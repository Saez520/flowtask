{
  "name": "end-turn",
  "description": "A turn that streams one message and closes with end_turn.",
  "session_id": "session-1",
  "behavior": {
    "on_cancel": "ignore",
    "on_stdin_end": "ignore",
    "start_after_stdin_end": false,
    "record_messages_to": null
  },
  "new_session_error": null,
  "steps": [
    {
      "emit_update": {
        "update": {
          "sessionUpdate": "agent_message_chunk",
          "content": {
            "type": "text",
            "text": "Hello"
          }
        }
      }
    },
    {
      "end_turn": {
        "stop_reason": "end_turn",
        "usage": {
          "inputTokens": 10,
          "outputTokens": 5
        }
      }
    }
  ]
}
