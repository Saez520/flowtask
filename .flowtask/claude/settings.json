{
  "mcpServers": {
    "engram": {
      "command": "engram",
      "args": ["mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/session-start.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
